  },
  "schemas": {
    "Dl24mSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cutoff_voltage_v": {
          "type": "number",
          "format": "double",
          "minimum": 0,
          "maximum": 25
        },
        "time_limit_s": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 86400,
          "multipleOf": 60
        },
        "working_brightness": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9
        },
        "standby_brightness": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 9
        },
        "current_resolution": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 2
        },
        "overvoltage_v": {
          "type": "number",
          "format": "double",
          "minimum": 3,
          "maximum": 25
        },
        "overcurrent_a": {
          "type": "number",
          "format": "double",
          "minimum": 0.05,
          "maximum": 2.5
        },
        "overpower_w": {
          "type": "number",
          "format": "double",
          "minimum": 1,
          "maximum": 15
        },
        "overtemperature_c": {
          "type": "integer",
          "format": "int64",
          "minimum": 40,
          "maximum": 100
        },
        "fan_temperature_c": {
          "type": "integer",
          "format": "int64",
          "minimum": 20,
          "maximum": 90
        },
        "battery_overtemperature_c": {
          "type": "integer",
          "format": "int64",
          "minimum": 40,
          "maximum": 100
        },
        "language": {
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "standby_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        }
      }
    },
    "Dl24mRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "quality"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "quality": {
          "type": "string",
          "enum": [
            "valid",
            "stale",
            "unavailable"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "received_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Dl24mRegisters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registers"
      ],
      "properties": {
        "registers": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Dl24mRegister"
          }
        }
      }
    },
    "Dl24mBankRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bank"
      ],
      "properties": {
        "bank": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "Dl24mBankTargetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bank",
        "target_raw"
      ],
      "properties": {
        "bank": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "target_raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2400,
          "description": "OFF-only bank target. Conservative maxima: bank 1=1000, bank 2=2400, bank 3=100. Returns to CC and restores its original target."
        }
      }
    }
  }
}
