{
  "x-labbridge-module": {
    "id": "rd60xx",
    "transports": [
      "usb",
      "uart"
    ],
    "capabilities": [
      "source.cc_cv",
      "output",
      "voltage.measure",
      "current.measure",
      "power.measure"
    ]
  },
  "paths": {
    "/api/v1/devices/{deviceId}/source/current": {
      "put": {
        "operationId": "setSourceCurrent",
        "tags": [
          "rd60xx"
        ],
        "responses": {
          "default": {
            "description": "Structured error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "202": {
            "description": "Operation accepted; poll Location until terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Operation URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            }
          },
          {
            "name": "X-Lab-Lease",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurrentRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{deviceId}/source/voltage": {
      "put": {
        "operationId": "setSourceVoltage",
        "tags": [
          "rd60xx"
        ],
        "responses": {
          "default": {
            "description": "Structured error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "202": {
            "description": "Operation accepted; poll Location until terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Operation URL",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            }
          },
          {
            "name": "X-Lab-Lease",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoltageRequest"
              }
            }
          }
        }
      }
    }
  },
  "schemas": {}
}
