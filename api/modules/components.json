  "schemas": {
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,96}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "sink",
            "sensor"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quantity": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "temperature_kind": {
          "type": "string",
          "enum": [
            "internal",
            "external_probe",
            "cell"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "actions"
      ]
    },
    "ComponentList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Component"
          }
        }
      },
      "required": [
        "components"
      ]
    },
    "SensorReading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "component_id": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "quantity": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "quality": {
          "type": "string",
          "enum": [
            "valid",
            "stale",
            "unavailable"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        },
        "sequence": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "received_ms": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "age_ms": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "component_id",
        "boot_id",
        "quantity",
        "unit",
        "quality",
        "sequence",
        "received_ms",
        "age_ms"
      ]
    },
    "SensorReadings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SensorReading"
          }
        }
      },
      "required": [
        "device_id",
        "boot_id",
        "readings"
      ]
    },
    "ActuatorSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voltage_v": {
          "type": "number"
        },
        "current_a": {
          "type": "number"
        },
        "cutoff_voltage_v": {
          "type": "number"
        },
        "time_limit_s": {
          "type": "integer",
          "minimum": 0
        },
        "regulation_mode": {
          "type": "string",
          "enum": [
            "cc",
            "cv",
            "unknown"
          ]
        }
      },
      "required": []
    },
    "ActuatorState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "component_id": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "unavailable",
            "ready",
            "busy",
            "fault"
          ]
        },
        "output": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "unknown"
          ]
        },
        "settings": {
          "$ref": "#/components/schemas/ActuatorSettings"
        }
      },
      "required": [
        "device_id",
        "component_id",
        "state",
        "output",
        "settings"
      ]
    },
    "CutoffRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cutoff_voltage_v": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "cutoff_voltage_v"
      ]
    },
    "DurationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_limit_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "required": [
        "time_limit_s"
      ]
    }
  }
