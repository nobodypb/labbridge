            }
          }
        },
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            }
          }
        ]
      }
    },
    "/api/v1/devices/{deviceId}/measurements": {
      "get": {
        "operationId": "getMeasurements",
