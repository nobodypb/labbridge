  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int64"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "final_output": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "unknown"
            ]
          },
          "restore_pending": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ]
      },
      "NodeInfo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "boot_id": {
            "type": "string"
          },
          "firmware_version": {
            "type": "string"
          },
          "board": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "boot_id",
          "firmware_version",
          "board",
          "api_version"
        ]
      },
      "SafetyLimits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voltage_v": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "current_a": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "power_w": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "max_age_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 100,
            "maximum": 3000
          },
          "max_duration_s": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "voltage_v",
          "current_a",
          "power_w",
          "max_age_ms"
        ]
      },
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "driver": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "unavailable",
              "ready",
              "busy",
              "fault"
            ]
          },
          "output": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "unknown"
            ]
          },
          "limits": {
            "$ref": "#/components/schemas/SafetyLimits"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Component"
            }
          }
        },
        "required": [
          "id",
          "driver",
          "identity",
          "transport",
          "capabilities",
          "state",
          "output"
        ]
      },
      "DeviceList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            }
          }
        },
        "required": [
          "devices"
        ]
      },
      "TemperatureChannel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "internal",
              "external_probe",
              "cell"
            ]
          },
          "quality": {
            "type": "string",
            "enum": [
              "valid",
              "stale",
              "unavailable"
            ]
          },
          "value_c": {
            "type": "number",
            "format": "double"
          },
          "received_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "age_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "quality",
          "received_ms",
          "age_ms"
        ]
      },
      "TemperatureChannels": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemperatureChannel"
            }
          }
        },
        "required": [
          "channels"
        ]
      },
      "Measurements": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "received_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "age_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "quality": {
            "type": "string",
            "enum": [
              "valid",
              "stale",
              "unavailable"
            ]
          },
          "voltage_v": {
            "type": "number",
            "format": "double"
          },
          "current_a": {
            "type": "number",
            "format": "double"
          },
          "power_w": {
            "type": "number",
            "format": "double"
          },
          "capacity_ah": {
            "type": "number",
            "format": "double"
          },
          "energy_wh": {
            "type": "number",
            "format": "double"
          },
          "temperature_channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemperatureChannel"
            }
          },
          "set_voltage_v": {
            "type": "number",
            "minimum": 0
          },
          "set_current_a": {
            "type": "number",
            "minimum": 0
          },
          "regulation_mode": {
            "type": "string",
            "enum": [
              "cc",
              "cv",
              "unknown"
            ]
          },
          "protection_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "boot_id": {
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "sequence",
          "received_ms",
          "age_ms",
          "quality",
          "temperature_channels"
        ]
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "stage": {
            "type": "string"
          },
          "read_attempts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "write_attempts": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "reconnects": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "confirmed_value": {
            "type": "number",
            "format": "double"
          },
          "final_output": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "unknown"
            ]
          },
          "restore_pending": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/Problem"
          },
          "component_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "device_id",
          "status",
          "stage",
          "read_attempts",
          "write_attempts",
          "reconnects",
          "duration_ms",
          "final_output",
          "restore_pending"
        ]
      },
      "OutputRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "max_duration_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 86400000,
            "description": "Optional local activation time cap; cannot exceed configured device duration."
          }
        },
        "required": [
          "enabled"
        ]
      },
      "CurrentRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "current_a": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 40
          }
        },
        "required": [
          "current_a"
        ]
      },
      "VoltageRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voltage_v": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 200
          }
        },
        "required": [
          "voltage_v"
        ]
      },
      "LeaseRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ttl_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 1000,
            "maximum": 10000,
            "default": 10000
          }
        },
        "required": [
          "device_ids"
        ]
      },
      "Lease": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "device_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "stopped",
              "expired"
            ]
          }
        },
        "required": [
          "id",
          "device_ids",
          "expires_at_ms",
          "state"
        ]
      },
      "StopRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "DeviceConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "driver": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 48
            }
          },
          "limits": {
            "$ref": "#/components/schemas/SafetyLimits"
          },
          "cell_temperature": {
            "$ref": "#/components/schemas/CellTemperatureGuard"
          },
          "interlock": {
            "$ref": "#/components/schemas/InterlockConfiguration"
          },
          "ina228": {
            "$ref": "#/components/schemas/Ina228Configuration"
          },
          "yocto_watt": {
            "$ref": "#/components/schemas/YoctoWattConfiguration"
          },
          "sensor_max_age_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 3000,
            "default": 1000
          }
        },
        "required": [
          "id",
          "driver",
          "transport",
          "endpoint"
        ]
      },
      "WifiNetwork": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ssid": {
            "type": "string"
          },
          "rssi_dbm": {
            "type": "integer",
            "format": "int64"
          },
          "secured": {
            "type": "boolean"
          }
        },
        "required": [
          "ssid",
          "rssi_dbm",
          "secured"
        ]
      },
      "WifiScan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "networks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WifiNetwork"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "scanning",
              "complete",
              "failed"
            ]
          }
        },
        "required": [
          "networks",
          "state"
        ]
      },
      "WifiRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ssid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "psk": {
            "type": "string",
            "maxLength": 64,
            "format": "password"
          }
        },
        "required": [
          "ssid",
          "psk"
        ]
      },
      "WifiState": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "setup",
              "connecting",
              "connected",
              "failed"
            ]
          },
          "hostname": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "hostname"
        ]
      },
      "NodeConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "board": {
            "type": "string"
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceConfiguration"
            }
          }
        },
        "required": [
          "revision",
          "node_id",
          "board",
          "devices"
        ]
      },
      "CellTemperatureGuard": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_device_id",
          "channel_id",
          "minimum_c",
          "maximum_c",
          "max_age_ms"
        ],
        "properties": {
          "sensor_device_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "channel_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "minimum_c": {
            "type": "number",
            "minimum": -20,
            "maximum": 80
          },
          "maximum_c": {
            "type": "number",
            "minimum": -20,
            "maximum": 80
          },
          "max_age_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 3000
          }
        }
      },
      "InterlockConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "active_high",
          "feedback_active_high",
          "break_ms"
        ],
        "properties": {
          "active_high": {
            "type": "boolean"
          },
          "feedback_active_high": {
            "type": "boolean"
          },
          "break_ms": {
            "type": "integer",
            "minimum": 20,
            "maximum": 2000
          }
        }
      },
      "ManagementToken": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "token"
        ]
      }
    }
  }
}
