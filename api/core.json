    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/node": {
      "get": {
        "operationId": "getNode",
        "tags": [
          "core"
        ],
        "responses": {
          "200": {
            "description": "Confirmed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeInfo"
                }
              }
            }
          },
          "default": {
            "description": "Structured error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
